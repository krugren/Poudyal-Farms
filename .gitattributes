# Auto-detect text files and normalise line endings to LF on commit
* text=auto eol=lf

# Force these to always be LF
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.sql  text eol=lf
*.mjs  text eol=lf

# Binaries — do not touch
*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
*.avif binary
*.ico  binary