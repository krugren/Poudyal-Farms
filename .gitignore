# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Next.js build output ────────────────────────────────────────────────────
.next/
out/
build/

# ─── Environment variables ───────────────────────────────────────────────────
# NEVER commit real .env files — copy .env.example and fill in locally
.env
.env.local
.env.development
.env.production
.env.staging
.env*.local

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite dev database — never commit this (contains guest data)
prisma/dev.db
prisma/dev.db-journal
prisma/*.db
prisma/*.db-wal
prisma/*.db-shm
*.sqlite

# ─── Uploaded user content ───────────────────────────────────────────────────
# Farm photos are committed now; move to Cloudflare R2 before production
# Uncomment the next line once R2 is set up:
# public/uploads/

# ─── Prisma generated client ─────────────────────────────────────────────────
# Regenerated via `npx prisma generate` — no need to track
node_modules/.prisma/

# ─── Logs ────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
logs/

# ─── OS / Editor ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

