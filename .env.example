# Copy this file to .env and fill in your values
# NEVER commit .env — only .env.example

# ─── Database ─────────────────────────────────────────────────────────────────
# Local SQLite (development)
DATABASE_URL="file:./prisma/dev.db"

# PostgreSQL (production — e.g. Neon, Supabase, Railway)
# DATABASE_URL="postgresql://user:password@host:5432/poudhyal_farms"

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-in-production"

# ─── Cloudflare R2 (image storage — optional until production) ───────────────
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="poudhyal-farms-uploads"
# R2_PUBLIC_URL="https://your-bucket.r2.dev"

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://poudhyalfarms.com"