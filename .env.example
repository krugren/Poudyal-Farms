# Copy this file to .env and fill in your values
# NEVER commit .env — only .env.example

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Get both URLs from: neon.tech → your project → Connection Details
# "Pooled connection" → DATABASE_URL (used by the app at runtime)
# "Direct connection" → DIRECT_URL  (used by Prisma migrations only)
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/poudhyal_farms?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/poudhyal_farms?sslmode=require"

# Local SQLite fallback (dev, no Neon needed):
# DATABASE_URL="file:./prisma/dev.db"

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-in-production"

# ─── Cloudflare R2 (image storage — optional) ────────────────────────────────
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="poudhyal-farms-uploads"
# R2_PUBLIC_URL="https://your-bucket.r2.dev"

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://poudyal-farms.vercel.app"